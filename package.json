{
  "name": "web-bash-agent",
  "version": "1.0.2",
  "type": "module",
  "description": "A vanilla js client-side bash-enabled agent",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-document": "^3.22.3",
    "@tiptap/extension-hard-break": "^3.22.3",
    "@tiptap/extension-history": "^3.22.3",
    "@tiptap/extension-mention": "^3.22.3",
    "@tiptap/extension-paragraph": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-text": "^3.22.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "11.9.0",
    "just-bash": "^2.14.0",
    "marked": "12.0.0",
    "marked-highlight": "2.2.1",
    "openai": "^6.33.0",
    "split.js": "^1.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^25.5.2",
    "astro": "^6.1.3",
    "jsdom": "^29.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}