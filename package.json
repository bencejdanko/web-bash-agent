{
  "name": "pagefind-bash-agent-astro",
  "version": "1.0.0",
  "type": "module",
  "description": "True Astro Integration for Pagefind Bash Agent",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./AgentIsland": {
      "import": "./dist/AgentIsland.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "integration.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "just-bash": "^2.14.0",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {},
  "devDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.1.3",
    "jsdom": "^29.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
