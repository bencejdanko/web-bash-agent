name = "llm-proxy"
main = "index.ts"
compatibility_date = "2024-04-05"

[vars]

# These are sensitive, optionally manage with:
# pnpm dlx wrangler secret put <var>
TURNSTILE_SECRET_KEY = ""
OPENROUTER_TOKEN = ""

# these are not sensitive, and set to * by default for simplicity
ALLOWED_ORIGINS = "*"
RATE_LIMIT_PER_MINUTE = 20


[observability]
[observability.logs]
enabled = true
invocation_logs = true

[observability.traces]
enabled = true