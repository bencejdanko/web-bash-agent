---
import { AgentSidebar, getAgentContextFilesystem, type ModelConfig } from 'pagefind-bash-agent-astro';
import path from 'node:path';

// 1. Resolve standardized paths
const repoRoot = path.join(process.cwd(), '../'); 
const agentsDir = path.join(repoRoot, '.agents');

// Mount main site (bence) content 
const benceDir = path.join(process.env.HOME || '/home/bence', 'bence'); 
const pagefindIndexDir = path.join(benceDir, 'dist/pagefind');
const postsDir = path.join(benceDir, 'src/content/posts');
const appendicesDir = path.join(benceDir, 'src/content/appendices');
const glossaryDir = path.join(benceDir, 'src/content/glossary');

// 2. Gather the virtual filesystem (metadata + index)
const realFilesystem: Record<string, string> = getAgentContextFilesystem({
    '/.agents': agentsDir,
    '/pagefind': pagefindIndexDir,
    '/content/posts': postsDir,
    '/content/appendices': appendicesDir,
    '/content/glossary': glossaryDir
});

// 3. Define Personas using VPaths
const AGENTS = [
    {
        id: 'researcher',
        name: 'Researcher',
        systemPromptPath: '/.agents/system_prompt.txt',
        description: 'Expert in content search and analysis.',
    },
    {
        id: 'coder',
        name: 'Technical Assistant',
        systemPromptPath: '/.agents/system_prompt.txt', // Reusing for now as placeholder
        description: 'Expert technical advisor.',
        skillsDir: '/.agents/skills', // Only shows skills from this dir
    }
];

// 4. Configuration for testing (Per-model credentials)
const PROXY_URL = "https://llm-proxy.bencejdanko.workers.dev"; // Change this to your actual worker URL

const MODELS: ModelConfig[] = [
    {
        id: "nvidia/nemotron-3-super-120b-a12b",
        name: "nemotron-3-super-120b-a12b",
        endpoint: PROXY_URL,
        keyIdentifier: "OPENROUTER_TOKEN",
        routerUrl: "https://openrouter.ai/api/v1"
    },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Real Test Page (VPath Prompts)</title>
        <script id="pagefind-agent-config" type="application/json" set:html={JSON.stringify({ 
            models: MODELS, 
            agents: AGENTS, 
            filesystem: realFilesystem, 
            initialModelId: MODELS[0].id,
            initialAgentId: AGENTS[0].id
        })} />
        <script is:inline>
            (async () => {
                try {
                    const pagefind = await import("/pagefind/pagefind.js");
                    window.pagefind = pagefind;
                    console.log("Pagefind loaded and attached to window.");
                } catch (e) {
                    console.warn("Pagefind index not found. Agent search will be disabled until site is built.");
                }
            })();
        </script>
	</head>
	<body style="font-family: sans-serif; padding: 2rem; max-width: 800px; margin: 0 auto; background: #f9fafb;">
		<div>
            <h1>Modular Pagefind Bash Agent</h1>
            <p>This is a test page using <strong>VPath-based System Prompts</strong>.</p>
            
            <div style="margin-top: 2rem;">
                <h2>Internal Search and Skills</h2>
                <p>The system prompt is now read from <code>/.agents/system_prompt.txt</code> at runtime.</p>
                <ul>
                    <li>Files loaded: {Object.keys(realFilesystem).length}</li>
                    <li>Agents available: {AGENTS.length}</li>
                </ul>
            </div>
        </div>

        <!-- Container for the Agent Sidebar -->
        <div id="pagefind-agent-manual-island"></div>

        <script>
            import { AgentSidebar } from 'pagefind-bash-agent-astro';

            const configEl = document.getElementById('pagefind-agent-config');
            if (configEl) {
                const config = JSON.parse(configEl.textContent || '{}');
                const sidebar = new AgentSidebar({
                    models: config.models,
                    initialModelId: config.initialModelId || config.models[0]?.id,
                    agents: config.agents,
                    initialAgentId: config.initialAgentId || config.agents[0]?.id,
                    filesystem: config.filesystem
                });
                
                const container = document.getElementById('pagefind-agent-manual-island');
                if (container) {
                    container.appendChild(sidebar.getElement());
                    sidebar.init();
                }
            }
        </script>

	</body>
</html>
