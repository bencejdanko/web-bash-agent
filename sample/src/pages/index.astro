---
import { AgentSidebar, getAgentContextFilesystem } from 'pagefind-bash-agent-astro';
import path from 'node:path';

// 1. Resolve standardized paths
const repoRoot = path.join(process.cwd(), '../'); 
const agentsDir = path.join(repoRoot, '.agents');
const pagefindIndexDir = path.join(process.cwd(), 'dist/pagefind');
const buildDir = path.join(process.cwd(), 'dist');

// 2. Gather the virtual filesystem (metadata + index)
const realFilesystem: Record<string, string> = getAgentContextFilesystem({
    agentsDir,
    pagefindIndexDir,
    buildDir
});

// 3. Extract the system prompt explicitly for total transparency
const systemPrompt = realFilesystem['/.agents/system_prompt.txt'];

// 4. Configuration for testing (Per-model credentials)
const OPENROUTER_TOKEN = "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";
const MODELS = [
    {
        id: "nvidia/nemotron-3-super-120b-a12b:free",
        name: "Nemotron 3 Super",
        endpoint: "https://openrouter.ai/api/v1",
        apiKey: OPENROUTER_TOKEN
    },
    {
        id: "google/gemini-2.0-flash-exp:free",
        name: "Gemini 2.0 Flash",
        endpoint: "https://openrouter.ai/api/v1",
        apiKey: OPENROUTER_TOKEN
    },
    {
        id: "meta-llama/llama-3.3-70b-instruct:free",
        name: "Llama 3.3 70B",
        endpoint: "https://openrouter.ai/api/v1",
        apiKey: OPENROUTER_TOKEN
    },
    {
        id: "deepseek/deepseek-r1:free",
        name: "DeepSeek R1",
        endpoint: "https://openrouter.ai/api/v1",
        apiKey: OPENROUTER_TOKEN
    }
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Real Test Page (Modular Agent)</title>
        <script is:inline>
            (async () => {
                try {
                    const pagefind = await import("/pagefind/pagefind.js");
                    window.pagefind = pagefind;
                    console.log("Pagefind loaded and attached to window.");
                } catch (e) {
                    console.warn("Pagefind index not found. Agent search will be disabled until site is built.");
                }
            })();
        </script>
	</head>
	<body style="font-family: sans-serif; padding: 2rem; max-width: 800px; margin: 0 auto; background: #f9fafb;">
		<div>
            <h1>Modular Pagefind Bash Agent</h1>
            <p>This is a test page using the new <strong>Modular Architecture</strong>.</p>
            
            <div style="margin-top: 2rem;">
                <h2>Internal Search and Skills</h2>
                <p>The agent below uses built-in Pagefind search and discoverable skills.</p>
                <ul>
                    <li>Files loaded: {Object.keys(realFilesystem).length}</li>
                </ul>
            </div>
        </div>

		<AgentSidebar 
            client:only="react" 
            models={MODELS}
            initialModelId={MODELS[0].id}
            systemPrompt={systemPrompt}
            filesystem={realFilesystem}
        />

	</body>
</html>
